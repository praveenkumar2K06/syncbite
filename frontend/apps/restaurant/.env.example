# Local development configuration.

# In development, leave blank so API calls use relative path /api/v1 through
# the Vite dev proxy to avoid CORS issues and hardcoded hosts.
VITE_API_URL=

# Backend target for the Vite dev server proxy (/api/v1 -> backend).
# Default: http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional outlet (branch) ID if this portal is pre-configured for a single outlet.
VITE_BRANCH_ID=
