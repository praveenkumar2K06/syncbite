# Google OAuth Client ID (Get this from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=

# SyncBite Backend API base URL. In development the Vite proxy forwards /api/v1 → http://127.0.0.1:8000.
# Set this to the full backend URL for staging/production (e.g. https://api.syncbite.app/api/v1).
VITE_API_URL=

# Backend target for the Vite dev server proxy (/api/v1 -> backend).
# Default: http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000