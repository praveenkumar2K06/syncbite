# SyncBite backend (syncbite_v2) base URL.
# Leave empty in development: the Vite dev proxy forwards /api/v1 -> http://127.0.0.1:8000
# (override that target with VITE_API_PROXY_TARGET). Set an absolute URL for
# staging/production, e.g. https://api.syncbite.app/api/v1
VITE_API_URL=

# Backend target for the Vite dev server proxy (/api/v1 -> backend).
# Default: http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Where restaurant managers sign in. Printed on the credential files generated
# in the dashboard, so it must match the deployed restaurant portal.
# Default: http://localhost:8444
VITE_RESTAURANT_PORTAL_URL=http://localhost:8444